#!/usr/bin/env bash
# cg: control the Crypto Grabber alert server.
set -uo pipefail
ENVF=/etc/crypto-grabber.env DIR=/opt/crypto-grabber
once() {   # one check right now, with extra settings (e.g. BRIEF=true), as the cg user
  [ "$(id -u)" = 0 ] || { echo "Run as root (or: sudo cg ...)"; exit 1; }
  set -a; . "$ENVF"; set +a
  runuser -u cg -- env $(grep -v '^\s*#' "$ENVF" | xargs) "$@" bash "$DIR/server/run.sh"
}
case "${1:-status}" in
  status)
    systemctl is-active --quiet crypto-grabber.timer && echo "Alerts: ON (every 5 minutes)" || echo "Alerts: OFF  (turn on with: cg start)"
    systemctl list-timers crypto-grabber.timer --no-pager | sed -n '1,2p'
    echo; echo "Last checks:"; journalctl -u crypto-grabber --no-pager -o short-iso -n 200 | grep -E "setup\(s\)|Sent:|No new alerts|rror|failed" | tail -8 ;;
  log)       journalctl -u crypto-grabber -f -o cat ;;
  test)      once TEST=true ;;
  brief)     once BRIEF=true ;;
  scorecard) once SCORECARD=true ;;
  today)     once DAILY=true ;;
  run)       once ;;
  backtest)
    [ "$(id -u)" = 0 ] || { echo "Run as root (or: sudo cg ...)"; exit 1; }
    cd "$DIR" && runuser -u cg -- env $(grep -v '^\s*#' "$ENVF" | xargs) BT_DAYS="${2:-120}" BT_TFS="${3:-1h,4h,1d}" BT_SET="${4:-zone}" node "$DIR/bot/backtest.js" ;;
  update)
    runuser -u cg -- git -C "$DIR" pull --ff-only
    runuser -u cg -- env $(grep -v '^\s*#' "$ENVF" | xargs) bash -c "cd $DIR/bot && npm install --no-audit --no-fund --silent && npx playwright install chromium"
    (cd "$DIR/bot" && set -a && . "$ENVF" && set +a && npx playwright install-deps chromium >/dev/null)
    install -m 755 "$DIR/server/cg" /usr/local/bin/cg; echo "Updated." ;;
  stop)      systemctl disable --now crypto-grabber.timer && echo "Alerts paused." ;;
  start)     systemctl enable --now crypto-grabber.timer && echo "Alerts on, every 5 minutes." ;;
  token)     echo "Edit $ENVF (nano $ENVF), save, done. It's read on every check." ;;
  dyor)      # connect a second Telegram chat (a private channel) for the 🔍 DYOR alerts
    [ "$(id -u)" = 0 ] || { echo "Run as root (or: sudo cg ...)"; exit 1; }
    set -a; . "$ENVF"; set +a
    echo "1. In Telegram: create a new Channel (private), e.g. 'Crypto Grabber DYOR'."
    echo "2. Channel info -> Administrators -> Add admin -> pick your alerts bot -> allow 'Post messages' -> Save."
    echo "3. Post any message in the channel (e.g. hi)."
    read -rp "Done? Press Enter... " _ </dev/tty
    OUT=$(curl -s "https://api.telegram.org/bot${TELEGRAM_TOKEN}/getUpdates")
    PICK=$(printf '%s' "$OUT" | node -e 'let d="";process.stdin.on("data",c=>d+=c).on("end",()=>{let id="",t="";try{for(const u of JSON.parse(d).result||[]){const c=(u.channel_post||u.message||u.my_chat_member||u.edited_channel_post||{}).chat;if(c&&c.type!=="private"){id=c.id;t=c.title||"";}}}catch(e){}process.stdout.write(id?id+"\t"+t:"");});')
    [ -n "$PICK" ] || { echo "Couldn't find the channel. Check the bot is an admin there, post another message, and run: cg dyor"; exit 1; }
    ID=${PICK%%$'\t'*}; TITLE=${PICK#*$'\t'}
    sed -i '/^TELEGRAM_DYOR_CHAT_ID=/d' "$ENVF"; printf 'TELEGRAM_DYOR_CHAT_ID=%s\n' "$ID" >> "$ENVF"; chmod 600 "$ENVF"
    curl -s -o /dev/null "https://api.telegram.org/bot${TELEGRAM_TOKEN}/sendMessage" --data-urlencode "chat_id=${ID}" \
      --data-urlencode "text=🔍 DYOR alerts connected. Setups that don't make the main alerts (below the rules, or any other timeframe: 15m, 1h, 1d, 3d, 1w) will come here."
    echo "Saved: DYOR alerts go to '${TITLE}'. You should see a 'DYOR alerts connected' message there."
    ;;
  github)    # save the GitHub token for the shared trade record (hidden input, never shown)
    [ "$(id -u)" = 0 ] || { echo "Run as root (or: sudo cg ...)"; exit 1; }
    read -rsp "Paste your GitHub token (hidden), then press Enter: " T </dev/tty; echo
    [ -n "$T" ] || { echo "Nothing pasted, nothing changed."; exit 1; }
    sed -i '/^CG_GITHUB_TOKEN=/d' "$ENVF"; printf 'CG_GITHUB_TOKEN=%s\n' "$T" >> "$ENVF"; chmod 600 "$ENVF"
    echo "Saved. Running one check to publish the trade record..."
    once >/tmp/cg-github.log 2>&1; grep -E "Trade record|publish failed|record" /tmp/cg-github.log || echo "Done. If nothing was published yet, it publishes on the next change."
    ;;
  *) cat <<'EOF'
cg            status: on/off, next check, last results
cg log        watch checks live (Ctrl+C to stop watching)
cg test       send the "connected" test message now
cg brief      send the BTC, ETH and alts briefs now
cg scorecard  send the weekly scorecard now
cg today      send today's scoreboard now (it also comes every night just after midnight)
cg run        run one check now
cg backtest   test the rules on real prices: cg backtest [days] [timeframes], e.g. cg backtest 365 4h
              (add ltf at the end for the lower-timeframe entries: cg backtest 365 4h ltf)
cg update     pull the latest files from GitHub and reinstall (normally automatic)
cg github     save the GitHub token for the shared trade record (phone and PC see the same trades)
cg dyor       connect a second Telegram channel for the 🔍 DYOR alerts (setups below the rules, and 15m / 1h / 1d / 3d / 1w)
cg stop       pause alerts        cg start   turn them back on
EOF
  ;;
esac
